{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOGHOLIZON",
  "version": "0.1.0",
  "identifier": "com.logholizon.desktop",
  "build": {
    "frontendDist": "../../app/.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --dir ../../app run dev:desktop",
    "beforeBuildCommand": "pnpm --dir ../../app run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "LOGHOLIZON",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Business",
    "shortDescription": "LOGHOLIZON offline business application platform",
    "longDescription": "Metadata-driven business apps (Accounting, Inventory, Sales, HR, POS, Manufacturing, Dormitory, Vehicle) running fully offline with a local SQLite database."
  }
}
