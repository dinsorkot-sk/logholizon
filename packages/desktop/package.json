{
  "name": "@logholizon/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm --dir ../app run build:desktop",
    "dev": "cargo tauri dev",
    "bundle": "cargo tauri build",
    "setup": "cargo tauri --version >/dev/null 2>&1 || cargo install tauri-cli --version '^2' --locked",
    "test": "cargo test -p logholizon-desktop --no-default-features",
    "check": "cargo clippy -p logholizon-desktop --no-default-features --all-targets -- -D warnings"
  }
}
